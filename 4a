import 'package:flutter/material.dart';

void main() {
  runApp(const ResponsiveApp());
}

String getDeviceCategory(double width) {
  if (width < 600) {
    return 'Mobile';
  } else if (width < 1024) {
    return 'Tablet';
  } else {
    return 'Desktop';
  }
}

class ResponsiveApp extends StatelessWidget {
  const ResponsiveApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive Gallery',
      theme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        useMaterial3: true,
      ),
      home: const GalleryPage(),
    );
  }
}

class GalleryPage extends StatelessWidget {
  const GalleryPage({super.key});

  final List<Map<String, dynamic>> items = const [
    {
      'title': 'Nature',
      'description': 'Explore the beauty of nature.',
      'icon': Icons.nature,
      'color': Colors.green,
    },
    {
      'title': 'Technology',
      'description': 'Discover modern technology.',
      'icon': Icons.computer,
      'color': Colors.blue,
    },
    {
      'title': 'Travel',
      'description': 'Travel and explore new places.',
      'icon': Icons.flight,
      'color': Colors.orange,
    },
    {
      'title': 'Education',
      'description': 'Learn something new every day.',
      'icon': Icons.school,
      'color': Colors.purple,
    },
    {
      'title': 'Photography',
      'description': 'Capture beautiful moments.',
      'icon': Icons.camera_alt,
      'color': Colors.pink,
    },
    {
      'title': 'Music',
      'description': 'Enjoy your favorite music.',
      'icon': Icons.music_note,
      'color': Colors.teal,
    },
  ];

  Widget buildCard(Map<String, dynamic> item, double textScale) {
    final Color color = item['color'] as Color;

    return Card(
      elevation: 4,
      clipBehavior: Clip.antiAlias,
      child: Padding(
        padding: EdgeInsets.all(16 * textScale),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              item['icon'] as IconData,
              size: 48 * textScale,
              color: color,
            ),
            const SizedBox(height: 12),
            Text(
              item['title'] as String,
              textAlign: TextAlign.center,
              style: TextStyle(
                fontSize: 20 * textScale,
                fontWeight: FontWeight.bold,
                color: color,
              ),
            ),
            const SizedBox(height: 8),
            Text(
              item['description'] as String,
              textAlign: TextAlign.center,
              style: TextStyle(fontSize: 14 * textScale),
            ),
          ],
        ),
      ),
    );
  }

  Widget buildMobileLayout(
    Orientation orientation,
    double width,
  ) {
    if (orientation == Orientation.portrait) {
      return ListView.builder(
        padding: const EdgeInsets.all(12),
        itemCount: items.length,
        itemBuilder: (context, index) {
          return SizedBox(
            height: 180,
            child: buildCard(items[index], 1),
          );
        },
      );
    }

    return ListView.builder(
      scrollDirection: Axis.horizontal,
      padding: const EdgeInsets.all(12),
      itemCount: items.length,
      itemBuilder: (context, index) {
        return SizedBox(
          width: width * 0.65,
          child: buildCard(items[index], 0.9),
        );
      },
    );
  }

  Widget buildTabletLayout(Orientation orientation) {
    final double padding =
        orientation == Orientation.landscape ? 24 : 16;

    return GridView.builder(
      padding: EdgeInsets.all(padding),
      itemCount: items.length,
      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        crossAxisSpacing:
            orientation == Orientation.landscape ? 24 : 16,
        mainAxisSpacing:
            orientation == Orientation.landscape ? 24 : 16,
        childAspectRatio:
            orientation == Orientation.landscape ? 1.5 : 1.1,
      ),
      itemBuilder: (context, index) {
        return buildCard(
          items[index],
          orientation == Orientation.landscape ? 1.2 : 1,
        );
      },
    );
  }

  Widget buildDesktopLayout() {
    return Row(
      children: [
        NavigationRail(
          selectedIndex: 0,
          onDestinationSelected: (index) {},
          labelType: NavigationRailLabelType.all,
          destinations: const [
            NavigationRailDestination(
              icon: Icon(Icons.home),
              label: Text('Home'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.explore),
              label: Text('Explore'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.settings),
              label: Text('Settings'),
            ),
          ],
        ),
        Expanded(
          child: GridView.builder(
            padding: const EdgeInsets.all(24),
            itemCount: items.length,
            gridDelegate:
                const SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: 3,
              crossAxisSpacing: 20,
              mainAxisSpacing: 20,
              childAspectRatio: 1.1,
            ),
            itemBuilder: (context, index) {
              return buildCard(items[index], 1.1);
            },
          ),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    final screenWidth = MediaQuery.of(context).size.width;
    final category = getDeviceCategory(screenWidth);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Responsive Gallery'),
        backgroundColor: Colors.indigo,
        foregroundColor: Colors.white,
      ),
      body: LayoutBuilder(
        builder: (context, constraints) {
          return OrientationBuilder(
            builder: (context, orientation) {
              final width = constraints.maxWidth;
              final currentCategory = getDeviceCategory(width);

              Widget content;

              if (width < 600) {
                content = buildMobileLayout(orientation, width);
              } else if (width < 1024) {
                content = buildTabletLayout(orientation);
              } else {
                content = buildDesktopLayout();
              }

              return Column(
                children: [
                  Expanded(child: content),
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(12),
                    color: Colors.indigo,
                    child: Text(
                      '$currentCategory | '
                      'Width: ${screenWidth.toStringAsFixed(0)} px | '
                      '${orientation == Orientation.portrait ? "Portrait" : "Landscape"}',
                      textAlign: TextAlign.center,
                      style: const TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              );
            },
          );
        },
      ),
    );
  }
}
